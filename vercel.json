{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [{ "source": "/catalogo", "destination": "/productos", "permanent": true }],
  "rewrites": [{ "source": "/((?!pedido|confirmacion).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
